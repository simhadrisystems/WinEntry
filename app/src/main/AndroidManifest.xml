<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions needed for Excel import/export -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Permissions needed for Cloud sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        GET_ACCOUNTS is required by GoogleAccountCredential.usingOAuth2() when
        building the Sheets API credential from a GoogleSignInAccount.
        The app ONLY reads the account that the user explicitly signed in with
        via the Google Sign-In flow — it never enumerates all device accounts.
        On Android 8.0+ this permission is automatically scoped to the calling
        package's own accounts, so no broad account enumeration is possible.
    -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <!--
        RECEIVE_BOOT_COMPLETED and WAKE_LOCK are required by WorkManager for
        background sync (every 6 hours when cloud backup is enabled).
        RECEIVE_BOOT_COMPLETED: reschedules the periodic sync job after a device
        restart so the sync continues uninterrupted.
        WAKE_LOCK: prevents the CPU from sleeping while a sync task runs to
        completion. Used only during active sync operations.
        Both are also auto-merged from WorkManager's library manifest, but
        declared here explicitly for Play Store Data Safety transparency.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.android.vending" />
        <package android:name="com.whatsapp" />
        <intent>
            <action android:name="com.google.android.gms.auth.api.signin.SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimpleInventory"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">
            <!--
                adjustNothing = window never translates or resizes for the keyboard.
                                Each fragment handles IME insets manually via
                                ViewCompat.setOnApplyWindowInsetsListener so its
                                scrollable container adds bottom padding equal to the
                                keyboard height, keeping content visible without ever
                                shifting the toolbar behind the status bar.

                adjustPan (old) caused the entire window to translate upward with
                edge-to-edge, pushing the toolbar behind the status bar.
                adjustResize pushes the system nav bar above the keyboard on
                3-button-nav devices.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider for sharing Excel files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
