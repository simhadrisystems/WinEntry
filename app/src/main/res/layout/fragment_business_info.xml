<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SimpleInventory.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Business Info"
            app:navigationIcon="@drawable/ic_chevron_left"
            app:menu="@menu/menu_business_info" />

    </com.google.android.material.appbar.AppBarLayout>

    <!--
        NestedScrollView fills from toolbar to screen bottom.
        scrollContent paddingBottom is expanded to keyboard height via IME insets in the fragment,
        so the Save button always scrolls into view above the keyboard.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Guidance note -->
            <TextView
                android:id="@+id/tvBusinessInfoNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Details saved here appear as the business header on all reports and on the Home screen."
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:background="?attr/colorSurfaceVariant"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:layout_marginBottom="12dp" />

            <!-- Section: Owner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OWNER"
                android:textSize="11sp"
                android:fontFamily="@font/ramabhadra_regular"
                android:textColor="#78909C"
                android:letterSpacing="0.12"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Owner / Contact Name (optional)"
                android:layout_marginBottom="8dp"
                app:boxBackgroundColor="@android:color/white"
                app:hintTextColor="#37474F"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editOwnerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#212121"
                    android:inputType="textCapWords"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone (optional, 10 digits)"
                android:layout_marginBottom="8dp"
                app:boxBackgroundColor="@android:color/white"
                app:hintTextColor="#37474F"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#212121"
                    android:inputType="phone"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Account email — auto-populated from Firebase Auth, read-only -->
            <TextView
                android:id="@+id/tvAccountEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <!-- Section: Business -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUSINESS"
                android:textSize="11sp"
                android:fontFamily="@font/ramabhadra_regular"
                android:textColor="#78909C"
                android:letterSpacing="0.12"
                android:layout_marginBottom="6dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Business Name"
                android:layout_marginBottom="8dp"
                app:boxBackgroundColor="@android:color/white"
                app:hintTextColor="#37474F"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editBusinessName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#212121"
                    android:fontFamily="@font/ramabhadra_regular"
                    android:inputType="textCapWords"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Licence / GST No. (optional)"
                android:layout_marginBottom="8dp"
                app:boxBackgroundColor="@android:color/white"
                app:hintTextColor="#37474F"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editLicenceNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#212121"
                    android:inputType="textCapCharacters"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Section: Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADDRESS"
                android:textSize="11sp"
                android:fontFamily="@font/ramabhadra_regular"
                android:textColor="#78909C"
                android:letterSpacing="0.12"
                android:layout_marginBottom="6dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="4dp" />

            <!--
                Fixed 2-line address field.
                First Enter: moves cursor to line 2.
                Second Enter: intercepted in fragment to move focus to City/Location.
            -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Address (optional)"
                android:layout_marginBottom="8dp"
                app:boxBackgroundColor="@android:color/white"
                app:hintTextColor="#37474F"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editAddress1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#212121"
                    android:inputType="textCapSentences|textMultiLine"
                    android:lines="2"
                    android:maxLines="2"
                    android:gravity="top|start"
                    android:scrollbars="vertical" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="City / Location (optional)"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="@android:color/white"
                app:hintTextColor="#37474F"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#212121"
                    android:inputType="textCapWords"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Registration status -->
            <TextView
                android:id="@+id/tvRegistrationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="○ Not Registered"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:paddingBottom="6dp" />

            <!-- Save button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save &amp; Register"
                android:textSize="15sp"
                android:backgroundTint="#FF1976D2" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
