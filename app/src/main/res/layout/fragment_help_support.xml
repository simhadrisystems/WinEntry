<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_toolbar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SimpleInventory.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Help &amp; Support"
            app:navigationIcon="@drawable/ic_chevron_left" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ── Section header ─────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOCUMENTATION"
                android:textSize="11sp"
                android:fontFamily="@font/ramabhadra_regular"
                android:textColor="@color/app_text_hint"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <!-- ── User Guide ──────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUserGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/settings_support_feature_light"
                app:rippleColor="#1A7C3AED">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_module_icon"
                        android:backgroundTint="@color/settings_support_feature_light">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_user_guide"
                            android:tint="@color/settings_support_feature"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="User Guide"
                            android:textSize="17sp"
                            android:fontFamily="@font/ramabhadra_regular"
                            android:textColor="@color/app_text_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Step-by-step guide to using the app."
                            android:textSize="13sp"
                            android:textColor="@color/app_text_secondary"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/settings_support_feature" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Section: GETTING STARTED ──────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GETTING STARTED"
                android:textSize="11sp"
                android:fontFamily="@font/ramabhadra_regular"
                android:textColor="@color/app_text_hint"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <!-- ── Import Test Data ───────────────────────────────── -->
            <!-- Active only when no committed daily stock data exists -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImportTestData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/settings_test_data_light"
                app:rippleColor="#1AD97706">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_module_icon"
                        android:backgroundTint="@color/settings_test_data_light">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_opening_stock"
                            android:tint="@color/settings_test_data"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Import Test Data"
                            android:textSize="17sp"
                            android:fontFamily="@font/ramabhadra_regular"
                            android:textColor="@color/app_text_primary" />
                        <TextView
                            android:id="@+id/tvTestDataStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Load sample stock data to explore the app."
                            android:textSize="13sp"
                            android:textColor="@color/app_text_secondary"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/settings_test_data" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Section header ─────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTACT SUPPORT"
                android:textSize="11sp"
                android:fontFamily="@font/ramabhadra_regular"
                android:textColor="@color/app_text_hint"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <!-- ── Ask for Help ────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAskHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/settings_support_help_light"
                app:rippleColor="#1A0284C7">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_module_icon"
                        android:backgroundTint="@color/settings_support_help_light">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_support"
                            android:tint="@color/settings_support_help"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contact Support"
                            android:textSize="17sp"
                            android:fontFamily="@font/ramabhadra_regular"
                            android:textColor="@color/app_text_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reach us via Email or WhatsApp."
                            android:textSize="13sp"
                            android:textColor="@color/app_text_secondary"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/settings_support_help" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Info note ───────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tapping any option above will open Email or WhatsApp with a pre-filled message that includes your app version and device info to help us resolve your issue faster."
                android:textSize="13sp"
                android:textColor="@color/app_text_hint"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:lineSpacingMultiplier="1.4" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
