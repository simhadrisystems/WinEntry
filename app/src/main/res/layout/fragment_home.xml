<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface">

    <!-- ── App bar ────────────────────────────────────────────────── -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_toolbar"
        android:fitsSystemWindows="true"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SimpleInventory.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetStart="0dp"
            app:contentInsetEnd="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/textAppTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WinEntry"
                    android:textSize="21sp"
                    android:fontFamily="@font/ramabhadra_regular"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.01" />

                <!-- Sync -->
                <ImageButton
                    android:id="@+id/btnSync"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@android:drawable/ic_popup_sync"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#FFFFFF"
                    android:contentDescription="Sync with cloud" />

                <!-- Profile / account button — circular, loads Google account photo -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_person"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_profile_circle"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CircleImageView"
                    android:contentDescription="Account and options" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── Content ───────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Business info banner — sits just under the toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/app_header_banner"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/textBusinessName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:fontFamily="@font/ramabhadra_regular"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textBusinessLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/app_text_hint"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select a module to begin"
                    android:textSize="13sp"
                    android:textColor="@color/app_text_hint"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Module navigation cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- ── Daily Stock ─────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDailyStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/module_daily_light"
                    app:rippleColor="#1A2563EB">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_module_icon"
                            android:backgroundTint="@color/module_daily_light">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_module_daily_stock"
                                android:scaleType="fitCenter" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView
                                android:id="@+id/textDailyStockTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Daily Stock"
                                android:textSize="17sp"
                                android:fontFamily="@font/ramabhadra_regular"
                                android:textColor="@color/app_text_primary" />
                            <TextView
                                android:id="@+id/textDailyStockDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Enter opening stock, log purchases and commit closing balances"
                                android:textSize="13sp"
                                android:textColor="@color/app_text_secondary"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/module_daily" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── Purchases ──────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPurchases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/module_purchases_light"
                    app:rippleColor="#1A059669">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_module_icon"
                            android:backgroundTint="@color/module_purchases_light">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_module_purchases"
                                android:scaleType="fitCenter" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView
                                android:id="@+id/textPurchasesTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Purchases"
                                android:textSize="17sp"
                                android:fontFamily="@font/ramabhadra_regular"
                                android:textColor="@color/app_text_primary" />
                            <TextView
                                android:id="@+id/textPurchasesDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Log supplier invoices — box quantities and unit prices per brand"
                                android:textSize="13sp"
                                android:textColor="@color/app_text_secondary"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/module_purchases" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── Reports ────────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/module_reports_light"
                    app:rippleColor="#1A7C3AED">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_module_icon"
                            android:backgroundTint="@color/module_reports_light">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_module_reports"
                                android:scaleType="fitCenter" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView
                                android:id="@+id/textReportsTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reports"
                                android:textSize="17sp"
                                android:fontFamily="@font/ramabhadra_regular"
                                android:textColor="@color/app_text_primary" />
                            <TextView
                                android:id="@+id/textReportsDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Daily stock sheets, monthly summaries and Excel exports"
                                android:textSize="13sp"
                                android:textColor="@color/app_text_secondary"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/module_reports" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── Products ──────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/settings_products_light"
                    app:rippleColor="#1AEA580C">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_module_icon"
                            android:backgroundTint="@color/settings_products_light">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_settings_products"
                                android:tint="@color/settings_products"
                                android:scaleType="fitCenter" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView
                                android:id="@+id/textProductsTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Products"
                                android:textSize="17sp"
                                android:fontFamily="@font/ramabhadra_regular"
                                android:textColor="@color/app_text_primary" />
                            <TextView
                                android:id="@+id/textProductsDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Display order, opening stock setup and master data"
                                android:textSize="13sp"
                                android:textColor="@color/app_text_secondary"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/settings_products" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── Settings ───────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/module_settings_light"
                    app:rippleColor="#1A64748B">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_module_icon"
                            android:backgroundTint="@color/module_settings_light">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_module_settings"
                                android:scaleType="fitCenter" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView
                                android:id="@+id/textSettingsTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Settings"
                                android:textSize="17sp"
                                android:fontFamily="@font/ramabhadra_regular"
                                android:textColor="@color/app_text_primary" />
                            <TextView
                                android:id="@+id/textSettingsDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Business info, sync settings and support"
                                android:textSize="13sp"
                                android:textColor="@color/app_text_secondary"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/module_settings" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
