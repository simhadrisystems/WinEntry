<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_toolbar"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".ui.auth.LoginFragment">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- App logo — PNG sits directly on the dark background, no wrapper circle -->
    <ImageView
        android:id="@+id/logoContainer"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/ic_app_logo"
        android:scaleType="fitCenter"
        android:contentDescription="App logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tvAppName"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.33"
        android:layout_marginBottom="20dp" />

    <!-- App name -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WinEntry"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.01"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoContainer"
        app:layout_constraintBottom_toTopOf="@+id/tvTagline"
        android:layout_marginBottom="8dp" />

    <!-- Tagline — two lines -->
    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_tagline"
        android:textSize="14sp"
        android:textColor="#94A3B8"
        android:letterSpacing="0.01"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAppName"
        app:layout_constraintBottom_toTopOf="@+id/btnSignIn"
        android:layout_marginBottom="52dp" />

    <!-- Google Sign-In button — white fill on dark background -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSignIn"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Sign in with Google"
        android:textSize="15sp"
        android:textColor="@color/app_text_primary"
        app:icon="@drawable/ic_google"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:backgroundTint="#FFFFFF"
        app:elevation="3dp"
        style="@style/Widget.Material3.Button.ElevatedButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTagline"
        app:layout_constraintBottom_toTopOf="@+id/tvStatus"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="16dp" />

    <!-- Status message (shown during auth) -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:visibility="gone"
        android:textSize="13sp"
        android:textColor="#94A3B8"
        app:layout_constraintBottom_toTopOf="@+id/progressBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="12dp"
        tools:text="Setting up your workspace…"
        tools:visibility="visible" />

    <!-- Progress indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminate="true"
        app:indicatorColor="#2563EB"
        app:trackColor="#334155"
        app:layout_constraintTop_toBottomOf="@+id/tvPrivacyPolicy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        tools:visibility="visible" />

    <!--
        Data-access disclosure — permanently visible below the sign-in button.
        Informs users what is (and is not) accessed before they tap sign-in.
        Required for Google OAuth verification compliance.
    -->
    <TextView
        android:id="@+id/tvDataAccess"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/data_access_brief"
        android:textSize="11sp"
        android:textAppearance="@style/TextAppearance.App.CardDescription"
        android:textAlignment="center"
        android:lineSpacingMultiplier="1.4"
        app:layout_constraintTop_toBottomOf="@+id/btnSignIn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp" />

    <!--
        Privacy Policy link — sits above the progress bar at the screen bottom.
        A tappable privacy policy URL is mandatory for Google OAuth verification
        and Play Store Data Safety requirements.
        Update strings.xml privacy_policy_url with your actual hosted URL.
    -->
    <TextView
        android:id="@+id/tvPrivacyPolicy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/privacy_policy_label"
        android:textSize="12sp"
        android:textAppearance="@style/TextAppearance.App.CardDescription"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvDataAccess"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
