<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="@color/app_toolbar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SimpleInventory.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Products"
            app:navigationIcon="@drawable/ic_chevron_left" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ── DISPLAY ─────────────────────────────────────────── -->
            <TextView
                android:id="@+id/textSectionDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISPLAY"
                android:textSize="11sp"
                android:fontFamily="@font/ramabhadra_regular"
                android:textColor="@color/app_text_hint"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProductOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/settings_order_light"
                app:rippleColor="#1A4338CA">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_module_icon"
                        android:backgroundTint="@color/settings_order_light">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_product_order"
                            android:tint="@color/settings_order"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:id="@+id/textProductOrderTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Product Display Order"
                            android:textSize="17sp"
                            android:fontFamily="@font/ramabhadra_regular"
                            android:textColor="@color/app_text_primary" />
                        <TextView
                            android:id="@+id/textProductOrderDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Set the order products appear in Daily Stock"
                            android:textSize="13sp"
                            android:textColor="@color/app_text_secondary"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/settings_order" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── STOCK SETUP ──────────────────────────────────────── -->
            <TextView
                android:id="@+id/textSectionStockSetup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STOCK SETUP"
                android:textSize="11sp"
                android:fontFamily="@font/ramabhadra_regular"
                android:textColor="@color/app_text_hint"
                android:letterSpacing="0.12"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOpeningStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/settings_stock_light"
                app:rippleColor="#1A0284C7">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_module_icon"
                        android:backgroundTint="@color/settings_stock_light">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_opening_stock"
                            android:tint="@color/settings_stock"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:id="@+id/textOpeningStockTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Opening Stock Setup"
                            android:textSize="17sp"
                            android:fontFamily="@font/ramabhadra_regular"
                            android:textColor="@color/app_text_primary" />
                        <TextView
                            android:id="@+id/textOpeningStockDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Set initial stock quantities for a new period"
                            android:textSize="13sp"
                            android:textColor="@color/app_text_secondary"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/settings_stock" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── MASTER DATA ──────────────────────────────────────── -->
            <TextView
                android:id="@+id/textSectionMasterData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MASTER DATA"
                android:textSize="11sp"
                android:fontFamily="@font/ramabhadra_regular"
                android:textColor="@color/app_text_hint"
                android:letterSpacing="0.12"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProductMasterData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/settings_products_light"
                app:rippleColor="#1AEA580C">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_module_icon"
                        android:backgroundTint="@color/settings_products_light">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_products"
                            android:tint="@color/settings_products"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:id="@+id/textProductMasterTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Product Master Data"
                            android:textSize="17sp"
                            android:fontFamily="@font/ramabhadra_regular"
                            android:textColor="@color/app_text_primary" />
                        <TextView
                            android:id="@+id/textProductMasterDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Product codes, sizes and pricing"
                            android:textSize="13sp"
                            android:textColor="@color/app_text_secondary"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/settings_products" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── CLOUD UPDATE ────────────────────────────────────── -->
            <TextView
                android:id="@+id/textSectionCloud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLOUD UPDATE"
                android:textSize="11sp"
                android:fontFamily="@font/ramabhadra_regular"
                android:textColor="@color/app_text_hint"
                android:letterSpacing="0.12"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDownloadProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/settings_download_light"
                app:rippleColor="#1A16A34A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_module_icon"
                        android:backgroundTint="@color/settings_download_light">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_download_products"
                            android:tint="@color/settings_download"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:id="@+id/textDownloadProductsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Download Standard Product List"
                            android:textSize="17sp"
                            android:fontFamily="@font/ramabhadra_regular"
                            android:textColor="@color/app_text_primary" />
                        <TextView
                            android:id="@+id/textDownloadProductsDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Import admin's standard product list as a starting point"
                            android:textSize="13sp"
                            android:textColor="@color/app_text_secondary"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/settings_download" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
