<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_toolbar"
        android:fitsSystemWindows="true">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SimpleInventory.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:title="Reports"
            app:navigationIcon="@drawable/ic_chevron_left"
            app:navigationContentDescription="Back" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- ── DAILY REPORTS ──────────────────────────────────── -->
            <TextView
                android:id="@+id/textSectionDailyReports"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAILY REPORTS"
                android:textSize="11sp"
                android:fontFamily="@font/ramabhadra_regular"
                android:textColor="@color/app_text_hint"
                android:letterSpacing="0.12"
                android:layout_marginBottom="9dp"
                android:layout_marginStart="4dp" />

            <!-- 1. Daily Stock Sheet -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDailySheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/reports_daily_light"
                app:rippleColor="#1A3B82F6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_module_icon"
                            android:backgroundTint="@color/reports_daily_light">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_report_daily_sheet"
                                android:tint="@color/reports_daily"
                                android:scaleType="fitCenter" />
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:id="@+id/textDailySheetTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Daily Stock Sheet"
                                android:textSize="15sp"
                                android:fontFamily="@font/ramabhadra_regular"
                                android:textColor="@color/app_text_primary"
                                android:maxLines="1"
                                android:ellipsize="end" />
                            <TextView
                                android:id="@+id/textDailySheetDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="OB · PQ · SQ · CB for all products on a date"
                                android:textSize="12sp"
                                android:textColor="@color/app_text_secondary"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDailySheetDate"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Select Date"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            app:strokeColor="@color/reports_daily"
                            android:textColor="@color/reports_daily" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDailySheetView"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="View Report"
                            android:textSize="12sp"
                            app:backgroundTint="@color/reports_daily" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Closing Balances -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardClosingBalances"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/reports_closing_light"
                app:rippleColor="#1A059669">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_module_icon"
                            android:backgroundTint="@color/reports_closing_light">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_report_closing_balance"
                                android:tint="@color/reports_closing"
                                android:scaleType="fitCenter" />
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:id="@+id/textClosingBalancesTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Closing Balances"
                                android:textSize="15sp"
                                android:fontFamily="@font/ramabhadra_regular"
                                android:textColor="@color/app_text_primary"
                                android:maxLines="1"
                                android:ellipsize="end" />
                            <TextView
                                android:id="@+id/textClosingBalancesDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="End-of-day stock balance by product and size"
                                android:textSize="12sp"
                                android:textColor="@color/app_text_secondary"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClosingDate"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Select Date"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            app:strokeColor="@color/reports_closing"
                            android:textColor="@color/reports_closing" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClosingView"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="View Report"
                            android:textSize="12sp"
                            app:backgroundTint="@color/reports_closing" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Monthly Sale Data -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMonthlySaleData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/reports_monthly_light"
                app:rippleColor="#1AD97706">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_module_icon"
                            android:backgroundTint="@color/reports_monthly_light">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_report_monthly_sale"
                                android:tint="@color/reports_monthly"
                                android:scaleType="fitCenter" />
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:id="@+id/textMonthlySaleTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Monthly Sale Data"
                                android:textSize="15sp"
                                android:fontFamily="@font/ramabhadra_regular"
                                android:textColor="@color/app_text_primary"
                                android:maxLines="1"
                                android:ellipsize="end" />
                            <TextView
                                android:id="@+id/textMonthlySaleDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Day-end totals · UPI receipts · Expenses · Cash deposit"
                                android:textSize="12sp"
                                android:textColor="@color/app_text_secondary"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonthlySaleView"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:text="Browse Months"
                        android:textSize="12sp"
                        app:backgroundTint="@color/reports_monthly" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Daily Brand Wise A/c -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBrandWise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFF1F8"
                app:strokeColor="@color/reports_accent_crimson"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_module_icon"
                            android:backgroundTint="#FFF1F8">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_report_brand_wise"
                                android:tint="@color/reports_accent_crimson"
                                android:scaleType="fitCenter" />
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:id="@+id/textBrandWiseTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Daily Brand Wise A/c"
                                android:textSize="15sp"
                                android:fontFamily="@font/ramabhadra_regular"
                                android:textColor="@color/reports_accent_crimson"
                                android:maxLines="1"
                                android:ellipsize="end" />
                            <TextView
                                android:id="@+id/textBrandWiseDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Form R2 — all brands, grouped by type"
                                android:textSize="12sp"
                                android:textColor="@color/app_text_secondary"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/checkIncludeZero"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Include zero-activity products"
                            android:textSize="12sp"
                            android:textColor="@color/app_text_secondary"
                            android:checked="false"
                            app:buttonTint="@color/reports_accent_crimson" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBrandWiseDate"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:textSize="12sp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            app:strokeColor="@color/reports_accent_crimson"
                            android:textColor="@color/reports_accent_crimson" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBrandWiseView"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="View"
                            android:textSize="12sp"
                            app:backgroundTint="@color/reports_accent_crimson" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── PERIOD REPORTS ─────────────────────────────────── -->
            <TextView
                android:id="@+id/textSectionPeriodReports"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERIOD REPORTS"
                android:textSize="11sp"
                android:fontFamily="@font/ramabhadra_regular"
                android:textColor="@color/app_text_hint"
                android:letterSpacing="0.12"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="9dp"
                android:layout_marginStart="4dp" />

            <!-- 5. Purchase Report -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPurchaseReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/reports_purchase_light"
                app:rippleColor="#1A7C3AED">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_module_icon"
                            android:backgroundTint="@color/reports_purchase_light">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_report_purchase"
                                android:tint="@color/reports_purchase"
                                android:scaleType="fitCenter" />
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:id="@+id/textPurchaseReportTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Purchase Report"
                                android:textSize="15sp"
                                android:fontFamily="@font/ramabhadra_regular"
                                android:textColor="@color/app_text_primary"
                                android:maxLines="1"
                                android:ellipsize="end" />
                            <TextView
                                android:id="@+id/textPurchaseReportDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Purchases by product with daily breakdown for a period"
                                android:textSize="12sp"
                                android:textColor="@color/app_text_secondary"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPurchaseFrom"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="From"
                            android:textSize="12sp"
                            android:layout_marginEnd="4dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            app:strokeColor="@color/reports_purchase"
                            android:textColor="@color/reports_purchase" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="–"
                            android:textSize="13sp"
                            android:textColor="@color/app_text_hint"
                            android:paddingHorizontal="2dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPurchaseTo"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="To"
                            android:textSize="12sp"
                            android:layout_marginStart="4dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            app:strokeColor="@color/reports_purchase"
                            android:textColor="@color/reports_purchase" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPurchaseView"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:text="View Report"
                        android:textSize="12sp"
                        app:backgroundTint="@color/reports_purchase" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. Sales & Profit Margin Report -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSalesMargin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/reports_margin_light"
                app:rippleColor="#1AEA580C">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_module_icon"
                            android:backgroundTint="@color/reports_margin_light">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_report_monthly_sale"
                                android:tint="@color/reports_margin"
                                android:scaleType="fitCenter" />
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:id="@+id/textSalesMarginTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sales &amp; Profit Margin"
                                android:textSize="15sp"
                                android:fontFamily="@font/ramabhadra_regular"
                                android:textColor="@color/reports_margin"
                                android:maxLines="1"
                                android:ellipsize="end" />
                            <TextView
                                android:id="@+id/textSalesMarginDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sale qty · Sale price · Buy price · Margin % for a period"
                                android:textSize="12sp"
                                android:textColor="@color/app_text_secondary"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSalesMarginFrom"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="From"
                            android:textSize="12sp"
                            android:layout_marginEnd="4dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            app:strokeColor="@color/reports_margin"
                            android:textColor="@color/reports_margin" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="–"
                            android:textSize="13sp"
                            android:textColor="@color/app_text_hint"
                            android:paddingHorizontal="2dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSalesMarginTo"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="To"
                            android:textSize="12sp"
                            android:layout_marginStart="4dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            app:strokeColor="@color/reports_margin"
                            android:textColor="@color/reports_margin" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSalesMarginView"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:text="View Report"
                        android:textSize="12sp"
                        app:backgroundTint="@color/reports_margin" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Guidance note — bottom -->
            <TextView
                android:id="@+id/tvReportsBusinessInfoNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Business name and owner details from Settings → Business Info appear as report headers on all reports."
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:background="?attr/colorSurfaceVariant"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
