<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_toolbar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SimpleInventory.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Settings"
            app:navigationIcon="@drawable/ic_chevron_left" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ── LANGUAGE ────────────────────────────────────────── -->
            <TextView
                android:id="@+id/textSectionLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LANGUAGE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/app_text_hint"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/settings_language_light"
                app:rippleColor="#1A0891B2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_module_icon"
                        android:backgroundTint="@color/settings_language_light">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_language"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:id="@+id/textLanguageTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App Language"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text_primary" />
                        <TextView
                            android:id="@+id/textLanguageDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="English / Telugu display"
                            android:textSize="13sp"
                            android:textColor="@color/app_text_secondary"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/settings_language" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── BUSINESS ────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/textSectionBusiness"
                android:text="BUSINESS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/app_text_hint"
                android:letterSpacing="0.12"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBusinessInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/settings_business_light"
                app:rippleColor="#1AE11D48">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_module_icon"
                        android:backgroundTint="@color/settings_business_light">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_business_info"
                            android:tint="@color/settings_business"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/textBusinessInfoTitle"
                            android:text="Business Info"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text_primary" />
                        <TextView
                            android:id="@+id/textBusinessInfoDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Business name, address and tax details for reports"
                            android:textSize="13sp"
                            android:textColor="@color/app_text_secondary"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/settings_business" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── SYNC ─────────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/textSectionSync"
                android:text="SYNC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/app_text_hint"
                android:letterSpacing="0.12"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSyncSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/settings_sync_light"
                app:rippleColor="#1A0D9488">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_module_icon"
                        android:backgroundTint="@color/settings_sync_light">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_sync"
                            android:tint="@color/settings_sync"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/textSyncSettingsTitle"
                            android:text="Sync Settings"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text_primary" />
                        <TextView
                            android:id="@+id/textSyncSettingsDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto-sync schedule and last sync status"
                            android:textSize="13sp"
                            android:textColor="@color/app_text_secondary"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/settings_sync" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── SUPPORT ────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/textSectionSupport"
                android:text="SUPPORT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/app_text_hint"
                android:letterSpacing="0.12"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHelpSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/settings_support_light"
                app:rippleColor="#1A7C3AED">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_module_icon"
                        android:backgroundTint="@color/settings_support_light">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_support"
                            android:tint="@color/settings_support"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/textHelpSupportTitle"
                            android:text="Help &amp; Support"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text_primary" />
                        <TextView
                            android:id="@+id/textHelpSupportDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Report issues, ask for help or request features"
                            android:textSize="13sp"
                            android:textColor="@color/app_text_secondary"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/settings_support" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Error Log — only visible when errors exist ───────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareErrorLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Share Error Log with Admin"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearErrorLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear Error Log"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                style="@style/Widget.Material3.Button.TextButton"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
