<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="6dp"
    app:cardBackgroundColor="@color/app_card"
    app:strokeWidth="1dp"
    app:strokeColor="@color/app_divider">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════════════════════════════════════════════════════
             ROW 1 — Product name + Sale amount + Save/Cancel
             Background driven by adapter: blue (clean) / amber (dirty) / red (negative)
             ══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/rowProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#DDEEFF"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/textProductName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Product Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0D47A1"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/textSaleAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginStart="8dp" />

            <ImageButton
                android:id="@+id/btnSaveProduct"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:src="@android:drawable/ic_menu_save"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#2E7D32"
                android:padding="4dp"
                android:contentDescription="Save this product"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnCancelProduct"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#C62828"
                android:padding="4dp"
                android:contentDescription="Discard edits for this product"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════
             EXCEL TABLE ZONE — column headers · OB · PQ · SQ
             Sits flush below the product name row (no top margin).
             Inset 6dp from card edges; outer border frames the zone.
             Column structure in every row:
               [34dp label] | [QQ w=1] | [PP w=1] | [NN w=1.1] | [DD w=1]
             The 1dp View separators are shared across all rows so
             columns align perfectly with the sticky strip above.
             ══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_excel_table_border">

            <!-- Column headers — 20dp, colour-coded QQ/PP/NN/DD; code in label cell -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:background="#F1F5F9">

                <!-- product code in label column — same 34dp width as data rows -->
                <TextView
                    android:id="@+id/textProductCode"
                    android:layout_width="34dp"
                    android:layout_height="match_parent"
                    android:text=""
                    android:textSize="9sp"
                    android:textColor="#64748B"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- vertical separator after label column -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="QQ"
                    android:textSize="13sp"
                    android:textColor="#FF4CAF50"
                    android:gravity="center"
                    android:includeFontPadding="false" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="PP"
                    android:textSize="13sp"
                    android:textColor="#FF2196F3"
                    android:gravity="center"
                    android:includeFontPadding="false" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.1"
                    android:text="NN"
                    android:textSize="13sp"
                    android:textColor="#FFFF9800"
                    android:gravity="center"
                    android:includeFontPadding="false" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="DD"
                    android:textSize="13sp"
                    android:textColor="@color/app_color_dd"
                    android:gravity="center"
                    android:includeFontPadding="false" />

            </LinearLayout>

            <!-- horizontal divider: headers → OB -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/app_divider" />

            <!-- OB row — read-only, no box borders; bold slate text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:background="@color/daily_ob_row">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="match_parent"
                    android:text="OB"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <TextView
                    android:id="@+id/textOpeningQQ"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="0"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:gravity="center"
                    android:padding="2dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <TextView
                    android:id="@+id/textOpeningPP"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="0"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:gravity="center"
                    android:padding="2dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <TextView
                    android:id="@+id/textOpeningNN"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.1"
                    android:text="0"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:gravity="center"
                    android:padding="2dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <TextView
                    android:id="@+id/textOpeningDD"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="0"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:gravity="center"
                    android:padding="2dp" />

            </LinearLayout>

            <!-- horizontal divider: OB → PQ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/app_divider" />

            <!-- PQ row — editable; adapter sets EditText background to transparent (no borders).
                 Row BG gives visual zone; hint="0" shows placeholder when blank. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:background="@color/daily_pq_row">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="match_parent"
                    android:text="PQ"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <EditText
                    android:id="@+id/editPurchaseQQ"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:hint="–"
                    android:textSize="17sp"
                    android:textColor="#C62828"
                    android:gravity="center"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:selectAllOnFocus="true"
                    android:background="@drawable/border_green"
                    android:padding="2dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <EditText
                    android:id="@+id/editPurchasePP"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:hint="–"
                    android:textSize="17sp"
                    android:textColor="#C62828"
                    android:gravity="center"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:selectAllOnFocus="true"
                    android:background="@drawable/border_blue"
                    android:padding="2dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <EditText
                    android:id="@+id/editPurchaseNN"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1.1"
                    android:hint="–"
                    android:textSize="17sp"
                    android:textColor="#C62828"
                    android:gravity="center"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:selectAllOnFocus="true"
                    android:background="@drawable/border_orange"
                    android:padding="2dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <EditText
                    android:id="@+id/editPurchaseDD"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:hint="–"
                    android:textSize="17sp"
                    android:textColor="#C62828"
                    android:gravity="center"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:selectAllOnFocus="true"
                    android:background="@drawable/border_purple"
                    android:padding="2dp" />

            </LinearLayout>

            <!-- horizontal divider: PQ → SQ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/app_divider" />

            <!-- SQ row — read-only calculated; adapter sets textColor only -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:background="@color/app_surface">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="match_parent"
                    android:text="SQ"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <TextView
                    android:id="@+id/textSaleQQ"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="0"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FF4CAF50"
                    android:gravity="center"
                    android:padding="2dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <TextView
                    android:id="@+id/textSalePP"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="0"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FF2196F3"
                    android:gravity="center"
                    android:padding="2dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <TextView
                    android:id="@+id/textSaleNN"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.1"
                    android:text="0"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFF9800"
                    android:gravity="center"
                    android:padding="2dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/app_divider" />

                <TextView
                    android:id="@+id/textSaleDD"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="0"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/app_color_dd"
                    android:gravity="center"
                    android:padding="2dp" />

            </LinearLayout>

        </LinearLayout>
        <!-- end EXCEL TABLE ZONE -->

        <!-- ══════════════════════════════════════════════════════════
             CB ROW — "Totals bar" matching sticky strip colour.
             Sits 5dp below the table zone for visual separation.
             Adapter overrides: EditText backgrounds (applyFieldState),
             btnEditClosing background (green patch in BALANCE mode).
             Text colours are XML-only — adapter does not touch them.
             ══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/daily_cb_bar"
            android:layout_marginTop="5dp"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <!-- CB label area — adapter sets background green (#A5D6A7) in BALANCE mode -->
            <LinearLayout
                android:id="@+id/btnEditClosing"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal|center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CB"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/cb_label_text"
                    android:lineSpacingExtra="0dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/textCbEntryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entry"
                    android:textSize="9sp"
                    android:textStyle="bold|italic"
                    android:textColor="@color/cb_text_qq"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="0dp"
                    android:visibility="invisible" />

            </LinearLayout>

            <EditText
                android:id="@+id/editClosingQQ"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_weight="1"
                android:text="0"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/cb_text_qq"
                android:gravity="center"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:selectAllOnFocus="true"
                android:background="@drawable/border_green"
                android:padding="2dp" />

            <EditText
                android:id="@+id/editClosingPP"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_weight="1"
                android:text="0"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/cb_text_pp"
                android:gravity="center"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:selectAllOnFocus="true"
                android:background="@drawable/border_blue"
                android:padding="2dp"
                android:layout_marginStart="3dp" />

            <EditText
                android:id="@+id/editClosingNN"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_weight="1.1"
                android:text="0"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/cb_text_nn"
                android:gravity="center"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:selectAllOnFocus="true"
                android:background="@drawable/border_orange"
                android:padding="2dp"
                android:layout_marginStart="3dp" />

            <EditText
                android:id="@+id/editClosingDD"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_weight="1"
                android:text="0"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/cb_text_dd"
                android:gravity="center"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:selectAllOnFocus="true"
                android:background="@drawable/border_purple"
                android:padding="2dp"
                android:layout_marginStart="3dp" />

        </LinearLayout>
        <!-- end CB ROW -->

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
