<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="3dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <!-- Editable position number — type a number to jump to that position -->
        <EditText
            android:id="@+id/editPosition"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/position_badge_bg"
            android:inputType="number"
            android:maxLength="3"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:padding="2dp" />

        <!-- Product name — up to 2 lines so full name is readable -->
        <TextView
            android:id="@+id/textProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:ellipsize="end"
            android:maxLines="2" />

        <!-- Up nudge -->
        <ImageButton
            android:id="@+id/btnMoveUp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@android:drawable/arrow_up_float"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Move up"
            android:tint="#0D47A1" />

        <!-- Down nudge -->
        <ImageButton
            android:id="@+id/btnMoveDown"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@android:drawable/arrow_down_float"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Move down"
            android:tint="#0D47A1" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
