<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Date Header — shown only for first invoice of a date -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDateHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/app_purchase_header"
        app:cardCornerRadius="4dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textDate"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Date: 22 Feb 2026"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDateTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total: ₹25,000.00"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Invoice Sub-header — shown for each invoice under the date -->
    <LinearLayout
        android:id="@+id/layoutInvoiceHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="2dp"
        android:paddingVertical="6dp"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical"
        android:background="#EDE7F6">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inv: "
            android:textSize="12sp"
            android:textColor="#4527A0"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textInvoiceNumber"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="INV-001"
            android:textSize="12sp"
            android:textColor="#4527A0"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textInvoiceTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹12,500.00"
            android:textSize="12sp"
            android:textColor="#4527A0"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Day Totals Row -->
    <LinearLayout
        android:id="@+id/layoutDayTotals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="2dp"
        android:paddingVertical="5dp"
        android:paddingHorizontal="8dp"
        android:background="#FFF3E0">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textDayTotalBoxes"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="45"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/textDayTotalLoose"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="23"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/textDayTotalUnits"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="1,234"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:gravity="end" />

    </LinearLayout>

    <!-- Product Item -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="2dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Product Name and Total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="4dp">

                <CheckBox
                    android:id="@+id/checkboxSelect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/textProductName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Product 01"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/app_text_primary" />

                <TextView
                    android:id="@+id/textProductTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹12,500.00"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

            <!-- Size Rows Container -->
            <LinearLayout
                android:id="@+id/layoutSizes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Size rows will be added dynamically -->
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
