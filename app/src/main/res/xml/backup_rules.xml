<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto-backup rules (API 31 and below).
    Include all sharedpref files, then exclude auth/sync prefs which are
    device- and account-bound. business_info and lang_prefs are backed up.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="inventory_prefs.xml" />
    <exclude domain="sharedpref" path="SyncPrefs.xml" />
</full-backup-content>
